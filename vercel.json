{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.js": { "maxDuration": 60 },
    "api/**/*.js": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "crons": [{ "path": "/api/cron/check-prices", "schedule": "0 1 * * *" }]
}
